# ─── Core ────────────────────────────────────────────────────────────
# Render sets PORT automatically; keep 4000 for local dev.
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (include the database name).
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/bunpho?retryWrites=true&w=majority

# Long random string — signs admin JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ─── First admin (owner), seeded on boot if no owner exists ──────────
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-this-strong-password
OWNER_NAME=Restaurant Owner

# ─── Google login (admin panel) ─────────────────────────────────────
# OAuth 2.0 Web client ID from Google Cloud Console. Same value goes to
# the frontend as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ─── Cloudinary (dish / category images) ────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# ─── Telegram (order notifications + accept/reject buttons) ─────────
# Create a bot with @BotFather. Only the token is required — the backend
# long-polls for updates and binds to whichever chat sends it /start.
TELEGRAM_BOT_TOKEN=123456789:AA...
# Optional: pin a specific chat/group id and ignore /start binding.
TELEGRAM_CHAT_ID=

# ─── Frontend / CORS ────────────────────────────────────────────────
# Public URL of the Vercel site. Used for CORS and for links in Telegram.
FRONTEND_URL=https://pho-imperial.vercel.app
# Extra comma-separated origins allowed by CORS (optional).
CORS_ORIGIN=http://localhost:3000
